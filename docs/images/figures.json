    {
      "id": "model-answers",
      "width": 980, "height": 306,
      "let": {
        "p": "=cr_contract_ex.response.answers.contract_risk.probability",
        "kind": "=fast_row.kind.response.answers.kind",
        "testable": "=fast_row.kind.response.answers.testable",
        "q_yes": "=find(cr_contract_ex.request.questions, 'id', 'contract_risk').question",
        "q_kind": "=find(fast_row.kind.request.questions, 'id', 'kind').question",
        "q_test": "=find(fast_row.kind.request.questions, 'id', 'testable').question",
        "options": "=pluck(q_kind.options, 'label')",
        "conditional": "=kind.probabilities.event + kind.probabilities.state + kind.probabilities.unwanted",
        "top": "=len(q_test.levels) - 1",
        "levels": "=str(range(len(q_test.levels)))",
        "kind_extra": "=join(['selected ', kind.selected, ' · confidence ', fmt(kind.confidence, 2)], '')",
        "test_extra": "=join(['expected ', fmt(testable.expected, 2), ' of ', top, ' · confidence ', fmt(testable.confidence, 2)], '')"
      },
      "label": "Three answers from Jev. Yes/no: yes {p:.2f}, no {1 - p:.2f}; counting label true gives {p:.2f}. Choice: {join(zip_join(options, fmt(pick(kind.probabilities, options), 2), ' '), ', ')}, {kind_extra}; counting event, state, unwanted gives {conditional:.2f}. Score: {join(rsub(zip_join(levels, fmt(pick(testable.probabilities, levels), 2), ' '), '^', 'level '), ', ')}, {test_extra}; counting level {top} gives {get(testable.probabilities, str(top)):.2f}.",
      "items": [
        {"k":"text","at":[0,16],"text":"yes / no","role":"ink","font":"title"},
        {"k":"para","at":[0,36],"text":"=q_yes.instructions","width":300},
        {"k":"repeat","over":["yes","no"],"let":{"y":"=76 + i * 24","v":"=if(i == 0, p, 1 - p)"},"items":[
          {"k":"text","at":[0,"=y + 10"],"text":"=row","role":"ink","size":12},
          {"k":"rect","at":[96,"=y",160,12],"role":"faint","stroke":false,"opacity":0.35,"rx":2},
          {"k":"bar","at":[96,"=y","=160 * v",12],"role":"=if(i == 0, 'model', 'muted')"},
          {"k":"text","at":[264,"=y + 10"],"text":"{v:.2f}","role":"ink","size":12}
        ]},
        {"k":"line","points":[[0,214],[300,214]],"role":"faint","weight":1,"arrow":false},
        {"k":"text","at":[0,238],"text":"probability","role":"model","font":"title"},
        {"k":"text","at":[0,258],"text":"labels [true]  →  {p:.2f}","role":"model","size":12},

        {"k":"text","at":[340,16],"text":"choice","role":"ink","font":"title"},
        {"k":"para","at":[340,36],"text":"=q_kind.instructions","width":300},
        {"k":"repeat","over":"options","let":{"y":"=76 + i * 24","v":"=get(kind.probabilities, row)"},"items":[
          {"k":"text","at":[340,"=y + 10"],"text":"=row","role":"ink","size":12},
          {"k":"rect","at":[436,"=y",160,12],"role":"faint","stroke":false,"opacity":0.35,"rx":2},
          {"k":"bar","at":[436,"=y","=160 * v",12],"role":"=if(contains(['event', 'state', 'unwanted'], row), 'model', 'muted')"},
          {"k":"text","at":[604,"=y + 10"],"text":"{v:.2f}","role":"ink","size":12}
        ]},
        {"k":"text","at":[340,190],"text":"=kind_extra","role":"muted","size":12},
        {"k":"line","points":[[340,214],[640,214]],"role":"faint","weight":1,"arrow":false},
        {"k":"text","at":[340,238],"text":"probability","role":"model","font":"title"},
        {"k":"text","at":[340,258],"text":"labels [event, state, unwanted]  →  {conditional:.2f}","role":"model","size":12},

        {"k":"text","at":[680,16],"text":"score","role":"ink","font":"title"},
        {"k":"para","at":[680,36],"text":"=q_test.instructions","width":300},
        {"k":"repeat","over":"=levels","let":{"y":"=76 + i * 24","v":"=get(testable.probabilities, row)"},"items":[
          {"k":"text","at":[680,"=y + 10"],"text":"level {row}","role":"ink","size":12},
          {"k":"rect","at":[776,"=y",160,12],"role":"faint","stroke":false,"opacity":0.35,"rx":2},
          {"k":"bar","at":[776,"=y","=160 * v",12],"role":"=if(row == str(top), 'model', 'muted')"},
          {"k":"text","at":[944,"=y + 10"],"text":"{v:.2f}","role":"ink","size":12}
        ]},
        {"k":"text","at":[680,190],"text":"=test_extra","role":"muted","size":12},
        {"k":"line","points":[[680,214],[980,214]],"role":"faint","weight":1,"arrow":false},
        {"k":"text","at":[680,238],"text":"probability","role":"model","font":"title"},
        {"k":"text","at":[680,258],"text":"labels [{top}]  →  {get(testable.probabilities, str(top)):.2f}","role":"model","size":12},
        {"k":"legend","at":[0,302],"entries":[["model","counted by probability","fill"],["muted","not counted","fill"]]}
      ]
    },
    {
      "id": "combine-strengths",
      "width": 900, "height": 236,
      "let": {
        "a": "=combine[0].support", "b": "=combine[1].support", "c": "=combine[2].support",
        "mean": "=(combine[0].weight * a + combine[1].weight * b + combine[2].weight * c) / (combine[0].weight + combine[1].weight + combine[2].weight)",
        "lo": "=min(a, b, c)", "hi": "=max(a, b, c)",
        "rows": [
          {"n":"min","w":"weakest part decides","y":64},
          {"n":"max","w":"strongest part decides","y":110},
          {"n":"weighted_mean","w":"weights 2 : 1 : 1","y":156}
        ],
        "scores": "=[lo, hi, mean]",
        "samples": [{"n":"A"},{"n":"B"},{"n":"C"}],
        "supports": "=[a, b, c]"
      },
      "label": "Strengths A {a:.1f}, B {b:.1f} and C {c:.1f}. Minimum gives {lo:.2f} and maximum {hi:.2f}; a weighted mean with weights {combine[0].weight}, {combine[1].weight} and {combine[2].weight} gives {mean:.2f}. With review when the result is below 0.7, minimum and mean ask for review and maximum does not.",
      "items": [
        {"k":"text","at":[0,34],"text":"strengths","role":"ink","font":"title"},
        {"k":"line","points":[[236,30],[716,30]],"role":"faint","weight":1,"arrow":false},
