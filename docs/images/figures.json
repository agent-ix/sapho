        {"k":"line","points":[[700,295],[772,295],[772,198]],"role":"code"},
        {"k":"line","points":[[804,170],[841,170]],"role":"logic","weight":2.4},
        {"k":"legend","at":[0,352],"entries":[["code","your code","box"],["model","model answer","box"],["logic","your rule","box"],["ink","input / decision","box"]]}
      ]
