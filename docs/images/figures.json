    {
      "id": "guard",
      "width": 980, "height": 420,
      "let": {
        "asked": "=where(stmts, 'experts.request.backend', 'expert')",
        "firsts": "=pluck(pluck(stmts, 'complete'), 'response.answers.complete.probability')",
        "unsure": "=pluck(pluck(asked, 'complete'), 'response.answers.complete.probability')",
