        "ticks": [{"t":"0"},{"t":"0.2"},{"t":"0.5"},{"t":"0.8"},{"t":"1"}]
      },
      "label": "First answers for {len(stmts)} requirements: {join(fmt(firsts, 2), ', ')}. Only {join(fmt(unsure, 2), ', ')} falls in the unsure band from 0.2 to 0.8, so only that statement goes to the expert, which answers {join(fmt(experts, 2), ', ')}. The others keep their first answer. Coalesce picks the expert's answer when one exists, and the result is compared with 0.8.",
      "items": [
        {"k":"text","at":[0,14],"text":"first answer · P(complete)","role":"ink","font":"title"},
        {"k":"rect","at":[298,28,384,128],"role":"evidence","stroke":false,"opacity":0.08,"rx":2},
        {"k":"text","at":[490,14],"text":"unsure: 0.2 ≤ P < 0.8 → ask the expert","role":"evidence","size":12,"anchor":"middle"},
        {"k":"repeat","over":"stmts","let":{"y":"=44 + i * 24","p":"=row.complete.response.answers.complete.probability","was_asked":"=len(row.experts) > 0","e":"=if(len(row.experts) > 0, row.experts[0].response.answers.complete.probability, 0)","px":"=170 + 640 * p","ex":"=170 + 640 * e"},"items":[
          {"k":"text","at":[0,"=y + 4"],"text":"=row.label","role":"ink","size":12},
