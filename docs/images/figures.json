          {"k":"dot","at":["=px","=y",5.5],"role":"model"},
          {"k":"text","at":["=px + 12","=y + 4"],"text":"{p:.2f}","role":"ink","size":12,"when":"=not was_asked and p < 0.9"},
          {"k":"text","at":["=px - 12","=y + 4"],"text":"{p:.2f}","role":"ink","size":12,"anchor":"end","when":"=not was_asked and p >= 0.9"},
          {"k":"line","points":[["=px - 8","=y"],["=ex + 9","=y"]],"role":"evidence","weight":1.5,"dashed":true,"when":"=was_asked"},
          {"k":"dot","at":["=ex","=y",5.5],"role":"evidence","filled":false,"when":"=was_asked"},
          {"k":"text","at":["=px + 12","=y + 4"],"text":"{p:.2f}","role":"ink","size":12,"when":"=was_asked"},
          {"k":"text","at":["=ex","=y - 10"],"text":"expert {e:.2f}","role":"evidence","size":12,"anchor":"middle","when":"=was_asked"}
        ]},
        {"k":"repeat","over":"ticks","items":[
