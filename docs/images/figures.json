        {"k":"note","at":[378,304],"text":"true","role":"logic"},
        {"k":"line","points":[[570,278],[595,278],[595,320],[617,320]],"role":"model","dashed":true},
        {"k":"note","at":[578,268],"text":"{fmt(experts[0], 2)}","role":"model","when":"=len(asked) == 1"},
