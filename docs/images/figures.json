          {"k":"text","at":[740,"=row.y + 15"],"text":"{v:.2f}","role":"ink","size":12},
          {"k":"text","at":[796,"=row.y + 15"],"text":"=if(v < 0.7, 'review', 'no review')","role":"=if(v < 0.7, 'evidence', 'muted')","font":"title"}
        ]},
        {"k":"line","points":[[572,48],[572,196]],"role":"evidence","weight":1.5,"dashed":true,"arrow":false},
        {"k":"text","at":[578,212],"text":"review if < 0.7","role":"evidence","size":12},
        {"k":"text","at":[236,212],"text":"0","role":"muted","size":12,"anchor":"middle"},
        {"k":"text","at":[476,212],"text":"0.5","role":"muted","size":12,"anchor":"middle"},
        {"k":"text","at":[716,212],"text":"1","role":"muted","size":12,"anchor":"middle"}
      ]
    },
