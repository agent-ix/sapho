    {
      "id": "how-it-works",
      "width": 980, "height": 356,
      "let": {
        "contract": "=cr_contract_ex.response.answers.contract_risk.probability",
        "gap": "=cr_contract_ex.response.answers.test_gap.probability",
        "api": "=cr_case.public_api_changed",
        "risky": "=contract >= 0.7",
        "untested": "=gap >= 0.8",
        "either": "=risky or untested",
        "decision": "=api and either"
      },
      "label": "A code change and two yes/no questions go to Jev in one request. Jev answers {contract:.2f} for contract risk and {gap:.2f} for a test gap. {contract:.2f} {if(risky, 'clears', 'misses')} its 0.7 threshold and {gap:.2f} {if(untested, 'clears', 'misses')} its 0.8 threshold, so OR gives {if(either, 'true', 'false')}. AND with the public_api_changed fact from your code gives needs_review = {if(decision, 'true', 'false')}.",
      "items": [
        {"k":"box","at":[156,4,128,64],"role":"model","title":"questions","subs":["contract_risk?","test_gap?"]},
        {"k":"box","at":[0,142,100,56],"role":"ink","title":"change","subs":["the diff"]},
        {"k":"box","at":[156,142,128,56],"role":"model","title":"ask Jev","subs":["1 request"]},
        {"k":"box","at":[324,98,136,50],"role":"model","title":"contract_risk","subs":["P(yes) = {contract:.2f}"]},
        {"k":"box","at":[324,192,136,50],"role":"model","title":"test_gap","subs":["P(yes) = {gap:.2f}"]},
        {"k":"box","at":[500,98,96,50],"role":"logic","title":"≥ 0.7","subs":["{if(risky, 'true', 'false')}"]},
        {"k":"box","at":[500,192,96,50],"role":"logic","title":"≥ 0.8","subs":["{if(untested, 'true', 'false')}"]},
        {"k":"box","at":[636,145,64,50],"role":"logic","title":"or","subs":["{if(either, 'true', 'false')}"]},
        {"k":"box","at":[500,270,200,50],"role":"code","title":"public_api_changed","subs":["your code · {if(api, 'true', 'false')}"]},
        {"k":"box","at":[740,145,64,50],"role":"logic","title":"and","subs":["{if(decision, 'true', 'false')}"]},
        {"k":"box","at":[844,142,136,56],"role":"ink","title":"needs_review","subs":["{if(decision, 'true', 'false')} + trace"]},
        {"k":"line","points":[[100,170],[153,170]],"role":"ink"},
        {"k":"note","at":[108,161],"text":"state","role":"muted"},
        {"k":"line","points":[[220,68],[220,139]],"role":"model"},
        {"k":"line","points":[[284,170],[304,170],[304,123],[321,123]],"role":"model"},
        {"k":"line","points":[[304,170],[304,217],[321,217]],"role":"model"},
        {"k":"note","at":[312,175],"text":"answers","role":"model"},
