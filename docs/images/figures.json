    "rq_ex": {"from":"json","path":"examples/recordings/requirement-check.json","pointer":"/exchanges","raw":true},
    "cr_cases": {"from":"json","path":"examples/data/code-review-dataset.json","pointer":"/cases","raw":true},
    "combine": {"from":"json","path":"examples/data/combine-input.json","pointer":"/samples","raw":true},
    "st_brake_lamp": {"from":"json","path":"examples/data/requirements/brake-lamp.json","pointer":"/statement"},
    "st_cabin_light": {"from":"json","path":"examples/data/requirements/cabin-light.json","pointer":"/statement"},
    "st_pump": {"from":"json","path":"examples/data/requirements/pump.json","pointer":"/statement"},
    "st_report": {"from":"json","path":"examples/data/requirements/report.json","pointer":"/statement"},
    "st_fast": {"from":"json","path":"examples/data/requirements/fast.json","pointer":"/statement"},
    "cr_contract_ex": {"from":"expr","value":"find(where(where(cr_ex, 'request.backend', 'judge'), 'request.questions.id', 'contract_risk'), 'request.state.value.change.value', cr_case.change)"},
    "tune_ranking": {"from":"json","path":"examples/reports/code-review-tune.json","pointer":"/ranking","raw":true},
    "held_metrics": {"from":"json","path":"examples/reports/code-review-measure-held-out.json","pointer":"/measurement/outputs/needs_review/metrics","raw":true},
    "judge_kind": {"from":"expr","value":"where(where(rq_ex, 'request.backend', 'judge'), 'request.questions.id', 'kind')"},
    "judge_complete": {"from":"expr","value":"where(where(rq_ex, 'request.backend', 'judge'), 'request.questions.id', 'complete')"},
    "expert_complete": {"from":"expr","value":"where(where(rq_ex, 'request.backend', 'expert'), 'request.questions.id', 'complete')"},
    "stmts": {"from":"expr","value":"[rec('label', 'brake lamp', 'kind', find(judge_kind, 'request.state.value.statement.value', st_brake_lamp), 'complete', find(judge_complete, 'request.state.value.statement.value', st_brake_lamp), 'experts', where(expert_complete, 'request.state.value.statement.value', st_brake_lamp)), rec('label', 'cabin light', 'kind', find(judge_kind, 'request.state.value.statement.value', st_cabin_light), 'complete', find(judge_complete, 'request.state.value.statement.value', st_cabin_light), 'experts', where(expert_complete, 'request.state.value.statement.value', st_cabin_light)), rec('label', 'pump pressure', 'kind', find(judge_kind, 'request.state.value.statement.value', st_pump), 'complete', find(judge_complete, 'request.state.value.statement.value', st_pump), 'experts', where(expert_complete, 'request.state.value.statement.value', st_pump)), rec('label', 'report promptly', 'kind', find(judge_kind, 'request.state.value.statement.value', st_report), 'complete', find(judge_complete, 'request.state.value.statement.value', st_report), 'experts', where(expert_complete, 'request.state.value.statement.value', st_report)), rec('label', 'respond quickly', 'kind', find(judge_kind, 'request.state.value.statement.value', st_fast), 'complete', find(judge_complete, 'request.state.value.statement.value', st_fast), 'experts', where(expert_complete, 'request.state.value.statement.value', st_fast))]"},
    "report_row": {"from":"expr","value":"stmts[3]"},
    "fast_row": {"from":"expr","value":"stmts[4]"},
    "brake_row": {"from":"expr","value":"stmts[0]"}
  },
